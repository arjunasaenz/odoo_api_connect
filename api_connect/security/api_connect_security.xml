<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_apiconnect" model="ir.module.category">
        <field name="name">API Connect</field>
        <field name="description">Conector API Connect (terminales de acceso)</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_apiconnect_user" model="res.groups">
        <field name="name">Usuario API Connect</field>
        <field name="category_id" ref="module_category_apiconnect"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_apiconnect_manager" model="res.groups">
        <field name="name">Administrador API Connect</field>
        <field name="category_id" ref="module_category_apiconnect"/>
        <field name="implied_ids" eval="[(4, ref('group_apiconnect_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
