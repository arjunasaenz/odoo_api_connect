<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_apiconnect_config_form" model="ir.ui.view">
        <field name="name">api.connect.config.form</field>
        <field name="model">api.connect.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Probar conexión" class="btn-primary" icon="fa-plug"/>
                    <button name="action_sync_terminals" type="object" string="Sincronizar terminales" icon="fa-refresh"/>
                    <button name="action_register_webhook" type="object" string="Registrar webhook en API Connect" class="btn-secondary" icon="fa-bell"/>
                    <button name="action_rotate_webhook_secret" type="object" string="Rotar secret del webhook" icon="fa-key"/>
                    <button name="action_check_redis" type="object" string="Salud Redis" icon="fa-heartbeat"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>API Connect</h1>
                    </div>
                    <group>
                        <group name="apiconnect_creds" string="Conexión">
                            <field name="base_url" placeholder="https://api-connect.rentipsolution.com"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                        </group>
                        <group name="apiconnect_webhook" string="Webhook">
                            <field name="webhook_url_display" readonly="1"/>
                            <field name="webhook_secret" readonly="1"/>
                        </group>
                    </group>
                    <group string="Marcaciones">
                        <field name="punch_window_minutes"/>
                        <field name="pairing_global"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_apiconnect_config" model="ir.actions.server">
        <field name="name">Configuración API Connect</field>
        <field name="model_id" ref="api_connect.model_api_connect_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_config()</field>
    </record>

    <record id="view_apiconnect_terminal_list" model="ir.ui.view">
        <field name="name">api.connect.terminal.list</field>
        <field name="model">api.connect.terminal</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <header>
                    <button name="action_sync_from_api" type="object" string="Sincronizar desde API Connect" class="btn-primary"/>
                    <button name="action_create_in_api" type="object" string="Crear seleccionadas en API Connect"/>
                </header>
                <field name="name"/>
                <field name="sn"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="group_id" widget="many2one" options="{'no_create': True}"/>
                <field name="tz"/>
                <field name="online" widget="boolean" decoration-success="online" decoration-muted="not online"/>
                <field name="last_sync"/>
                <field name="expire_day"/>
                <field name="api_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_apiconnect_terminal_form" model="ir.ui.view">
        <field name="name">api.connect.terminal.form</field>
        <field name="model">api.connect.terminal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_in_api" type="object" string="Crear en API Connect" class="btn-primary" icon="fa-cloud-upload" invisible="api_id"/>
                    <button name="action_update_in_api" type="object" string="Actualizar en API" class="btn-primary" icon="fa-save" invisible="not api_id"/>
                    <button name="action_refresh_parameters" type="object" string="Refrescar parámetros" icon="fa-cogs" invisible="not api_id"/>
                    <button name="action_unlock_quick" type="object" string="Desbloquear (5 s)" icon="fa-unlock-alt" invisible="not api_id"/>
                    <button name="action_cmd_sync_time" type="object" string="Sincronizar hora" icon="fa-clock-o" invisible="not api_id"/>
                    <button name="%(action_api_connect_message_wizard)d" type="action" string="Enviar mensaje" icon="fa-comment-o" invisible="not api_id"/>
                    <button name="%(action_api_connect_wiegand_wizard)d" type="action" string="Wiegand" icon="fa-id-card" invisible="not api_id"/>
                    <button name="action_restore_factory" type="object" string="Restaurar fábrica" icon="fa-warning" confirm="Esto enviará el comando de restauración de fábrica a la terminal. ¿Continuar?" groups="api_connect.group_apiconnect_manager" invisible="not api_id"/>
                    <button name="action_cmd_reboot" type="object" string="Reiniciar" icon="fa-power-off" confirm="¿Enviar REBOOT a la terminal?" groups="api_connect.group_apiconnect_manager" invisible="not api_id"/>
                    <button name="action_cmd_clear_log" type="object" string="Borrar logs" icon="fa-eraser" confirm="¿Borrar los registros de marcaciones del dispositivo?" groups="api_connect.group_apiconnect_manager" invisible="not api_id"/>
                    <button name="action_cmd_clear_data" type="object" string="Borrar TODOS los datos" icon="fa-trash" confirm="BORRARÁ usuarios, rostros, tarjetas y marcaciones del dispositivo. ¿Seguro?" groups="api_connect.group_apiconnect_manager" invisible="not api_id"/>
                    <button name="action_hk_reset_access" type="object" string="Reset acceso (HK)" icon="fa-undo" confirm="Restablecerá los ajustes de acceso del panel Hikvision. ¿Continuar?" groups="api_connect.group_apiconnect_manager" invisible="not api_id or brand != 'HK'"/>
                    <button name="action_hk_factory_settings" type="object" string="Fábrica puertas (HK)" icon="fa-exclamation-triangle" confirm="Ajustes de fábrica por puerta del panel Hikvision. ¿Continuar?" groups="api_connect.group_apiconnect_manager" invisible="not api_id or brand != 'HK'"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Registrada en API" bg="success" invisible="not api_id"/>
                    <group>
                        <group name="terminal_main" string="Terminal">
                            <field name="name"/>
                            <field name="sn"/>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="group_id" readonly="1"/>
                            <field name="api_group_id" readonly="1" groups="api_connect.group_apiconnect_manager"/>
                            <field name="tz"/>
                        </group>
                        <group name="terminal_hk" string="Hikvision" invisible="brand != 'HK'">
                            <field name="device_id" readonly="not api_id"/>
                            <field name="device_key" password="True" readonly="not api_id"/>
                        </group>
                        <group name="terminal_state" string="Estado">
                            <field name="api_id" readonly="1"/>
                            <field name="online" readonly="1"/>
                            <field name="last_sync" readonly="1"/>
                            <field name="auto_renew" readonly="1"/>
                            <field name="expire_day" readonly="1"/>
                        </group>
                        <group name="terminal_capacity" string="Capacidades del equipo">
                            <field name="device_type" readonly="1"/>
                            <field name="device_name" readonly="1"/>
                            <field name="door_count" readonly="1"/>
                            <field name="reader_count" readonly="1"/>
                            <field name="params_synced_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Puertas" name="page_doors">
                            <field name="door_ids" readonly="1">
                                <list>
                                    <field name="door_number"/>
                                    <field name="name"/>
                                    <field name="open_time"/>
                                    <button name="action_open_door" type="object" string="Abrir" icon="fa-unlock-alt" class="btn-secondary"/>
                                    <button name="action_open_door_settings" type="object" string="Configurar" icon="fa-cogs" class="btn-secondary" groups="api_connect.group_apiconnect_manager"/>
                                </list>
                            </field>
                        </page>
                        <page string="Comandos" name="page_commands">
                            <div class="d-flex gap-2 mb-2">
                                <button name="action_fetch_responses" type="object" string="Consultar respuestas del dispositivo (hoy)" icon="fa-inbox"/>
                                <button name="action_cmd_reload_options" type="object" string="Reload options" icon="fa-download"/>
                                <button name="action_cmd_check" type="object" string="Check" icon="fa-check"/>
                                <button name="%(action_api_connect_publicity_wizard)d" type="action" string="Publicidad" icon="fa-picture-o"/>
                            </div>
                            <field name="command_ids" readonly="1">
                                <list>
                                    <field name="sent_at"/>
                                    <field name="action"/>
                                    <field name="status" decoration-success="status == 'ok'" decoration-danger="status == 'failed'"/>
                                    <field name="api_response"/>
                                </list>
                            </field>
                        </page>
                        <page string="Horarios de acceso" name="page_schedules">
                            <div class="d-flex gap-2 mb-2">
                                <button name="%(action_api_connect_access_group_wizard)d" type="action" string="Grupo de acceso (ZK)" icon="fa-users" groups="api_connect.group_apiconnect_manager"/>
                                <button name="%(action_api_connect_visitor_wizard)d" type="action" string="Registrar visitante" icon="fa-user-secret" groups="api_connect.group_apiconnect_manager"/>
                            </div>
                            <field name="access_schedule_ids">
                                <list editable="bottom">
                                    <field name="schedule_number"/>
                                    <field name="mon_start1" string="Lun ini"/>
                                    <field name="mon_end1" string="Lun fin"/>
                                    <field name="tue_start1" string="Mar ini"/>
                                    <field name="tue_end1" string="Mar fin"/>
                                    <field name="wed_start1" string="Mié ini"/>
                                    <field name="wed_end1" string="Mié fin"/>
                                    <field name="thu_start1" string="Jue ini"/>
                                    <field name="thu_end1" string="Jue fin"/>
                                    <field name="fri_start1" string="Vie ini"/>
                                    <field name="fri_end1" string="Vie fin"/>
                                    <field name="sat_start1" string="Sáb ini"/>
                                    <field name="sat_end1" string="Sáb fin"/>
                                    <field name="sun_start1" string="Dom ini"/>
                                    <field name="sun_end1" string="Dom fin"/>
                                    <field name="synced_once" readonly="1" optional="hide"/>
                                    <button name="action_set_schedule" type="object" string="Enviar" icon="fa-upload" class="btn-primary" groups="api_connect.group_apiconnect_manager"/>
                                    <button name="action_delete_schedule" type="object" string="Borrar" icon="fa-trash" confirm="¿Borrar este horario del dispositivo?" groups="api_connect.group_apiconnect_manager"/>
                                </list>
                            </field>
                        </page>
                        <page string="Feriados" name="page_holidays">
                            <field name="access_holiday_ids">
                                <list editable="bottom">
                                    <field name="holiday_number" string="Nº (ZK)"/>
                                    <field name="name" string="Nombre (ZK)"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="year"/>
                                    <field name="holiday_type"/>
                                    <field name="holiday_loop" string="Loop (HK)"/>
                                    <field name="access_time_id" string="Horario (ZK TA)"/>
                                    <button name="action_set_holiday" type="object" string="Enviar" icon="fa-upload" class="btn-primary" groups="api_connect.group_apiconnect_manager"/>
                                </list>
                            </field>
                        </page>
                        <page string="Parámetros crudos" name="page_params">
                            <field name="parameters_json" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_apiconnect_terminal_search" model="ir.ui.view">
        <field name="name">api.connect.terminal.search</field>
        <field name="model">api.connect.terminal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sn"/>
                <filter string="En línea" name="online" domain="[('online', '=', True)]"/>
                <filter string="Fuera de línea" name="offline" domain="[('online', '=', False)]"/>
                <group expand="0" string="Marca">
                    <filter string="ZKTeco" name="brand_zk" domain="[('brand', '=', 'ZK')]"/>
                    <filter string="Hikvision" name="brand_hk" domain="[('brand', '=', 'HK')]"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_apiconnect_terminal" model="ir.actions.act_window">
        <field name="name">Terminales</field>
        <field name="res_model">api.connect.terminal</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_apiconnect_terminal_group_list" model="ir.ui.view">
        <field name="name">api.connect.terminal.group.list</field>
        <field name="model">api.connect.terminal.group</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="description"/>
                <field name="color_code"/>
                <field name="api_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_apiconnect_terminal_group_form" model="ir.ui.view">
        <field name="name">api.connect.terminal.group.form</field>
        <field name="model">api.connect.terminal.group</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_in_api" type="object" string="Crear en API Connect" class="btn-primary" icon="fa-cloud-upload" invisible="api_id"/>
                    <button name="action_update_in_api" type="object" string="Actualizar en API" icon="fa-save" invisible="not api_id"/>
                    <button name="action_delete_from_api" type="object" string="Eliminar (también en API)" icon="fa-trash" confirm="Se eliminará el grupo en API Connect y las terminales quedarán sin grupo. ¿Continuar?" groups="api_connect.group_apiconnect_manager" invisible="not api_id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Registrado en API" bg="success" invisible="not api_id"/>
                    <group>
                        <group string="Grupo">
                            <field name="name"/>
                            <field name="description"/>
                            <field name="color_code"/>
                            <field name="api_id" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Terminales del grupo"/>
                    <field name="terminal_ids">
                        <list>
                            <field name="name"/>
                            <field name="sn"/>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="online"/>
                            <field name="last_sync"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_apiconnect_terminal_group" model="ir.actions.act_window">
        <field name="name">Grupos de terminales</field>
        <field name="res_model">api.connect.terminal.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_apiconnect_webhook_retry_list" model="ir.ui.view">
        <field name="name">api.connect.webhook.retry.list</field>
        <field name="model">api.connect.webhook.retry</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_sync_retries" type="object" string="Sincronizar desde API Connect" class="btn-primary" groups="api_connect.group_apiconnect_manager"/>
                    <button name="action_reprocess" type="object" string="Reprocesar seleccionadas" groups="api_connect.group_apiconnect_manager" confirm="¿Reprocesar los webhooks seleccionados en Odoo? Son idempotentes (sin duplicados)."/>
                </header>
                <field name="event_time"/>
                <field name="estado" decoration-warning="estado == 'vivo'" decoration-muted="estado == 'muerto'" decoration-success="estado == 'reprocesado'"/>
                <field name="sn"/>
                <field name="terminal_name"/>
                <field name="pin"/>
                <field name="table" optional="hide"/>
                <field name="attempt"/>
                <field name="last_status_code" optional="hide"/>
                <field name="last_error"/>
                <field name="next_retry_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_apiconnect_webhook_retry_form" model="ir.ui.view">
        <field name="name">api.connect.webhook.retry.form</field>
        <field name="model">api.connect.webhook.retry</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reprocess" type="object" string="Reprocesar en Odoo" class="btn-primary" groups="api_connect.group_apiconnect_manager"/>
                </header>
                <sheet>
                    <group>
                        <group string="Resumen">
                            <field name="uuid" readonly="1"/>
                            <field name="estado" readonly="1"/>
                            <field name="sn" readonly="1"/>
                            <field name="terminal_name" readonly="1"/>
                            <field name="pin" readonly="1"/>
                            <field name="table" readonly="1"/>
                        </group>
                        <group string="Detalles">
                            <field name="event_time" readonly="1"/>
                            <field name="attempt" readonly="1"/>
                            <field name="last_status_code" readonly="1"/>
                            <field name="next_retry_at" readonly="1"/>
                            <field name="expires_at" readonly="1"/>
                            <field name="created_at" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Último error"/>
                    <field name="last_error" readonly="1"/>
                    <separator string="Payload"/>
                    <field name="payload" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_apiconnect_webhook_retry_search" model="ir.ui.view">
        <field name="name">api.connect.webhook.retry.search</field>
        <field name="model">api.connect.webhook.retry</field>
        <field name="arch" type="xml">
            <search>
                <field name="pin"/>
                <field name="sn"/>
                <field name="terminal_name"/>
                <filter string="Pendientes" name="estado_vivo" domain="[('estado', '=', 'vivo')]"/>
                <filter string="En dead-letter" name="estado_muerto" domain="[('estado', '=', 'muerto')]"/>
                <filter string="Reprocesadas" name="estado_reprocesado" domain="[('estado', '=', 'reprocesado')]"/>
            </search>
        </field>
    </record>

    <record id="action_apiconnect_webhook_retry" model="ir.actions.act_window">
        <field name="name">Webhooks fallidos</field>
        <field name="res_model">api.connect.webhook.retry</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_apiconnect_event_list" model="ir.ui.view">
        <field name="name">api.connect.event.list</field>
        <field name="model">api.connect.event</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_reprocess" type="object" string="Reprocesar seleccionadas" groups="api_connect.group_apiconnect_manager" confirm="¿Reprocesar las marcaciones seleccionadas? Se buscará de nuevo el empleado por su PIN."/>
                </header>
                <field name="received_at"/>
                <field name="timestamp_local"/>
                <field name="sn"/>
                <field name="pin"/>
                <field name="employee_id"/>
                <field name="direction"/>
                <field name="state" decoration-success="state == 'processed'" decoration-warning="state in ['no_employee', 'no_terminal', 'unmatched', 'out_group']" decoration-danger="state == 'error'" decoration-muted="state in ['repeated', 'stale', 'loose_out', 'invalid']"/>
                <field name="attendance_id"/>
                <field name="note" optional="hide"/>
                <field name="event_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_apiconnect_event_search" model="ir.ui.view">
        <field name="name">api.connect.event.search</field>
        <field name="model">api.connect.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="pin"/>
                <field name="sn"/>
                <field name="employee_id"/>
                <filter string="Procesadas" name="state_processed" domain="[('state', '=', 'processed')]"/>
                <filter string="Repetidas" name="state_repeated" domain="[('state', '=', 'repeated')]"/>
                <filter string="Sin empleado con ese PIN" name="state_no_employee" domain="[('state', '=', 'no_employee')]"/>
                <filter string="Terminal desconocida" name="state_no_terminal" domain="[('state', '=', 'no_terminal')]"/>
                <filter string="Descartadas" name="state_discarded" domain="[('state', 'in', ['stale', 'loose_out', 'invalid'])]"/>
                <filter string="Con error" name="state_error" domain="[('state', '=', 'error')]"/>
            </search>
        </field>
    </record>

    <record id="action_apiconnect_event" model="ir.actions.act_window">
        <field name="name">Marcaciones recibidas</field>
        <field name="res_model">api.connect.event</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_apiconnect_root" name="API Connect" sequence="70" web_icon="api_connect,static/description/icon2.png" groups="api_connect.group_apiconnect_user"/>

    <record id="action_server_bulk_register" model="ir.actions.server">
        <field name="name">API Connect: Alta masiva en terminales</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="groups_id" eval="[(6, 0, [ref('api_connect.group_apiconnect_manager')])]"/>
        <field name="code">records.action_bulk_register()</field>
    </record>

    <record id="action_server_bulk_remove" model="ir.actions.server">
        <field name="name">API Connect: Baja masiva de terminales</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="groups_id" eval="[(6, 0, [ref('api_connect.group_apiconnect_manager')])]"/>
        <field name="code">records.action_bulk_remove()</field>
    </record>
    <menuitem id="menu_apiconnect_terminal" name="Terminales" parent="menu_apiconnect_root" action="action_apiconnect_terminal" sequence="10"/>
    <menuitem id="menu_apiconnect_terminal_group" name="Grupos de terminales" parent="menu_apiconnect_root" action="action_apiconnect_terminal_group" sequence="15" groups="api_connect.group_apiconnect_manager"/>
    <menuitem id="menu_apiconnect_event" name="Marcaciones recibidas" parent="menu_apiconnect_root" action="action_apiconnect_event" sequence="20"/>
    <menuitem id="menu_apiconnect_retries" name="Webhooks fallidos" parent="menu_apiconnect_root" action="action_apiconnect_webhook_retry" sequence="25" groups="api_connect.group_apiconnect_manager"/>
    <menuitem id="menu_apiconnect_config" name="Configuración" parent="menu_apiconnect_root" action="action_apiconnect_config" sequence="30" groups="api_connect.group_apiconnect_manager"/>
</odoo>
